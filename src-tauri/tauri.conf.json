{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aerial Manager",
  "version": "0.1.0",
  "identifier": "io.github.kimmjen.aerial-manager",
  "build": {
    "beforeDevCommand": "npx vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npx vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Aerial Manager", "width": 1280, "height": 860, "minWidth": 900, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
